rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow read: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);

      allow update: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/tickets/$(ticketId)).data.createdBy == request.auth.uid);

        allow create: if isAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/tickets/$(ticketId)).data.createdBy == request.auth.uid
              && request.resource.data.authorId == request.auth.uid);

        allow update, delete: if false;
      }
    }
  }
}